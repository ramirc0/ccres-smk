rule all:
    input:
        [
            f"{OUTDIR}/{genome}/{genome}-{mark}-maxZ.parquet"
            for genome in GENOMES
            for mark in MARKS
        ],
        [f"{OUTDIR}/{genome}/{genome}-PLS-Gene-List.txt" for genome in GENOMES],
        [f"{OUTDIR}/{genome}/rDHS/{genome}-Constants.tsv" for genome in GENOMES],
        lambda w: [
            path
            for genome in GENOMES
            for path in [
                f"{OUTDIR}/{genome}/Cell-Type-Specific/Master-Cell-List.txt",
                *cell_type_files(genome),
            ]
        ],
