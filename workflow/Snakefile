
include: "rules/common.smk"
include: "rules/inputs.smk"
include: "rules/dhs.smk"
include: "rules/tf.smk"
include: "rules/signal.smk"
include: "rules/classify.smk"


rule all:
    input:
        [
            f"{OUTDIR}/{genome}/{genome}-{mark}-maxZ.txt"
            for genome in GENOMES
            for mark in MARKS
        ],
        [f"{OUTDIR}/{genome}/{genome}-PLS-Gene-List.txt" for genome in GENOMES],
        [f"{OUTDIR}/{genome}/rDHS/{genome}-Constants.tsv" for genome in GENOMES],
        # Step 7 needs the frozen TF list of the release's TF-flagged biosamples.
        lambda w: [
            path
            for genome in GENOMES
            if "TF-List.Cell-Type.txt" in config["sources"][genome]
            for path in [
                f"{OUTDIR}/{genome}/Cell-Type-Specific/Master-Cell-List.txt",
                *cell_type_files(genome),
            ]
        ],
