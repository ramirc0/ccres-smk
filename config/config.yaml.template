      source: /data/zusers/moorej3/moorej.ghpcc.project/ENCODE/Encyclopedia/V7/Registry/V7-hg38/hg38-TF/hg38-TF-List.All.txt
    Biosample-Keys.txt:
      kind: biosample-keys
      frozen:
        - DNase-List.txt
        - H3K4me3-List.txt
        - H3K27ac-List.txt
        - CTCF-List.txt
