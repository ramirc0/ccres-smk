      frozen: [DNase-List.txt]
    DNase-List.txt:
      kind: refresh
      source: /data/zusers/moorej3/moorej.ghpcc.project/ENCODE/Encyclopedia/V7/Registry/V7-mm10/DNase-List.txt
    H3K4me3-List.txt:
      kind: refresh
      source: /data/zusers/moorej3/moorej.ghpcc.project/ENCODE/Encyclopedia/V7/Registry/V7-mm10/H3K4me3-List.txt
    H3K27ac-List.txt:
      kind: refresh
      source: /data/zusers/moorej3/moorej.ghpcc.project/ENCODE/Encyclopedia/V7/Registry/V7-mm10/H3K27ac-List.txt
    CTCF-List.txt:
      kind: refresh
      source: /data/zusers/moorej3/moorej.ghpcc.project/ENCODE/Encyclopedia/V7/Registry/V7-mm10/CTCF-List.txt
    ATAC-List.txt:
