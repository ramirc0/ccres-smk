outdir: data/results
pixi_env: default
run_id: v7               # outputs go under <outdir>/<run_id>/<genome>/; override per run

inputs_dir: data/inputs                      # frozen inputs, checked against config/inputs.b3
encode_root: /data/projects/encode/data      # ENCODE mirror, <exp>/<file>.<ext>
download_dir: data/encode                    # same layout, for files missing from the mirror
# ENCODE file report snapshot (s3_uri, md5sum) used by download_encode.
encode_metadata: /home/ramirezc/Projects/encode-metadata-smk/results/2026-10-09/parquets/file.parquet

# Constants hardcoded in the original scripts. No published code derives them.
# min_p: minP in 0_Call-DHSs.sh (last FDR threshold, 1E-<min_p>). That script
#   is hardcoded to hg38, so the mm10 value is unverified.
# dhs_signal_cutoff: 2_Create-rDHSs.sh, "10% of 10,000,000 randomly selected
#   DHSs". The sample and its seed were not kept.
genomes:
  hg38:
    min_p: 4942
    dhs_signal_cutoff: 0.145873
  mm10:
    min_p: 4942
    dhs_signal_cutoff: 0.203923

# Frozen input name -> source file(s). freeze_input copies a single source.
# The two derived inputs filter their sources (see workflow/scripts/freeze_input.py).
sources:
