    rDHS-Previous.bed.gz: /data/zusers/moorej3/moorej.ghpcc.project/ENCODE/Encyclopedia/Previous-Versions/rDHS.hg38.bed.gz
    cCREs-Previous.bed:
      kind: previous-ccres
      source: /data/zusers/moorej3/moorej.ghpcc.project/ENCODE/Encyclopedia/Previous-Versions/cCREs.hg38.bed.gz
    TSS-Basic.bed: /data/zusers/moorej3/moorej.ghpcc.project/Reference/Human/hg38/GENCODE40/TSS.Basic.bed
    TSS-Basic-4K.bed: /data/zusers/moorej3/moorej.ghpcc.project/Reference/Human/hg38/GENCODE40/TSS.Basic.4K.bed
    chromInfo.txt: /data/zusers/moorej3/moorej.ghpcc.project/Reference/Human/hg38/chromInfo.txt
